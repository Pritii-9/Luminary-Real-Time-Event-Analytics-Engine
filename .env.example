# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=events:raw
REDIS_STREAM_MAXLEN=100000

# CORS
CORS_ORIGINS=http://localhost:3000

# JWT Auth
JWT_SECRET=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# SQLite metadata DB path (relative to backend/)
SQLITE_PATH=data/luminary.db

# GeoIP (optional, path to MaxMind GeoLite2-City.mmdb)
GEOIP_DB_PATH=

# AI & Security (optional, OpenAI API Key for LLM incident reasoning)
OPENAI_API_KEY=
